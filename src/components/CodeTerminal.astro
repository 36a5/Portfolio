---
/**
 * Hero code card. The snippet is the shape of the routing agent from the SDAIA
 * capstone — lines fade in one after another, and the last one keeps a caret.
 *
 * Lines are divs with `whitespace-pre` rather than a <pre>: inside a <pre> the
 * newlines the template emits between elements would each render as an extra
 * blank line and double the card's height.
 */
const lines: { text: string; cls?: string }[] = [
  { text: 'from langgraph.func import entrypoint, task', cls: 'text-accent-2' },
  { text: '' },
  { text: '@task', cls: 'text-accent-3' },
  { text: 'def route(question: str) -> str:' },
  { text: '    """Send it where it can be answered."""', cls: 'text-muted' },
  { text: '    return classify(question).source' },
  { text: '' },
  { text: '@entrypoint()', cls: 'text-accent-3' },
  { text: 'def answer(question: str) -> Answer:' },
  { text: '    source = route(question).result()' },
  { text: '    if source == "unclear":' },
  { text: '        return escalate(question)  # a human', cls: 'text-muted' },
  { text: '    draft = agents[source].invoke(question)' },
  { text: '    return draft if grounded(draft) else retry()' },
];
---

<div
  class="relative overflow-hidden rounded-xl border border-border bg-raised shadow-2xl shadow-black/30"
  data-reveal
  style="--reveal-delay:180ms"
>
  <div class="flex items-center gap-2 border-b border-border bg-surface px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-accent-3/80"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-accent-2/80"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-accent/80"></span>
    <span class="ml-2 font-mono text-xs text-muted">routing_agent.py</span>
  </div>

  <div class="overflow-x-auto px-4 py-3.5 font-mono text-[11px] leading-5 sm:text-xs">
    {
      lines.map((line, i) => (
        <div
          class:list={['whitespace-pre opacity-0', line.cls ?? 'text-ink']}
          style={`animation: rise .4s cubic-bezier(.22,1,.36,1) ${0.3 + i * 0.07}s forwards`}
        >
          {line.text || ' '}
          {i === lines.length - 1 && <span class="caret" />}
        </div>
      ))
    }
  </div>
</div>
