---
interface Props { tone?: 'default' | 'accent' | 'outline' }
const { tone = 'default' } = Astro.props;
const tones = {
  default: 'border border-border bg-surface text-muted hover:border-accent/60 hover:text-ink',
  accent: 'border border-accent/40 bg-accent-soft text-accent',
  outline: 'border border-dashed border-border text-muted',
};
---
<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-1 font-mono text-xs transition-colors',
    tones[tone],
  ]}
>
  <slot />
</span>
