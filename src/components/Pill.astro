---
interface Props { tone?: 'default' | 'accent' | 'outline' }
const { tone = 'default' } = Astro.props;
const tones = {
  default: 'bg-surface text-muted',
  accent: 'bg-accent-soft text-accent',
  outline: 'border border-border text-muted',
};
---
<span class:list={['inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium', tones[tone]]}>
  <slot />
</span>
