---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { monthYear } from '../lib/format';
import Pill from './Pill.astro';

interface Props { credential: CollectionEntry<'credentials'> }
const { credential } = Astro.props;
const { data } = credential;
---
<article class="flex gap-4 rounded-xl border border-border bg-surface p-4 transition hover:border-accent">
  {
    data.image && (
      <a href={data.credentialUrl ?? '#'} class="hidden shrink-0 sm:block">
        <Image src={data.image} alt={data.title} width={96} height={96} class="h-24 w-24 rounded-lg object-cover" loading="lazy" />
      </a>
    )
  }
  <div class="flex flex-1 flex-col gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <Pill tone={data.kind === 'certification' ? 'accent' : 'default'}>
        {data.kind === 'certification' ? 'Certification' : 'Certificate'}
      </Pill>
      {data.issueDate && <span class="text-xs text-muted">{monthYear(data.issueDate)}</span>}
      {data.expiryDate && (
        <span class="text-xs text-muted">· expires {monthYear(data.expiryDate)}</span>
      )}
    </div>

    <h3 class="font-semibold leading-snug">
      {
        data.credentialUrl ? (
          <a href={data.credentialUrl} target="_blank" rel="noopener" class="hover:text-accent">
            {data.title}
          </a>
        ) : (
          data.title
        )
      }
    </h3>

    <p class="text-sm text-muted">{data.issuer}</p>
    {data.credentialId && <p class="font-mono text-xs text-muted">ID {data.credentialId}</p>}

    {
      data.skills.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {data.skills.slice(0, 6).map((s) => (
            <Pill>{s}</Pill>
          ))}
        </div>
      )
    }
  </div>
</article>
