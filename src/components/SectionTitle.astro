---
interface Props {
  index?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { index, title, href, linkLabel } = Astro.props;
---
<div class="flex flex-wrap items-end justify-between gap-3" data-reveal>
  <div>
    {index && <p class="font-mono text-xs tracking-[0.2em] text-accent-2">{index}</p>}
    <h2 class="mt-1.5 text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
    <div class="mt-2 h-px w-16 bg-gradient-to-r from-accent to-transparent"></div>
  </div>
  {
    href && (
      <a href={href} class="group font-mono text-sm text-accent hover:underline">
        {linkLabel}
        <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
      </a>
    )
  }
</div>
