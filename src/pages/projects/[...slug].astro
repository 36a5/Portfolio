---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CoverImage from '../../components/CoverImage.astro';
import Pill from '../../components/Pill.astro';
import { href } from '../../data/site';
import { dateRange } from '../../lib/format';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const facts = [
  ['Timeline', dateRange(data.startDate, data.endDate, data.status)],
  ['Role', data.role],
  ['Team', data.team.length > 0 ? data.team.join(', ') : undefined],
  ['Languages', data.languages.length > 0 ? data.languages.join(', ') : undefined],
  ['Tools', data.tools.length > 0 ? data.tools.join(', ') : undefined],
].filter(([, value]) => Boolean(value)) as [string, string][];
---

<Base title={data.title} description={data.summary}>
  <nav class="py-6 text-sm">
    <a href={href('/projects')} class="text-muted hover:text-accent">← All projects</a>
  </nav>

  <article>
    <header>
      <div class="flex flex-wrap items-center gap-2">
        {data.status === 'in-progress' && <Pill tone="accent">Active</Pill>}
        {data.tags.map((tag) => <Pill>{tag}</Pill>)}
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{data.summary}</p>
    </header>

    {
      /* A full-width gradient placeholder is dead space on a detail page; the
         card grid keeps its placeholder, this only renders with a real image. */
      data.cover && (
        <div class="mt-8 aspect-[16/9] overflow-hidden rounded-xl border border-border">
          <CoverImage src={data.cover} alt={data.coverAlt} title={data.title} />
        </div>
      )
    }

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px]">
      <div
        class="max-w-none [&_a]:text-accent [&_a]:underline [&_code]:rounded [&_code]:bg-surface [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-semibold [&_li]:my-1 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:my-4 [&_p]:leading-relaxed [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:border [&_pre]:border-border [&_pre]:p-4 [&_strong]:font-semibold [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6"
      >
        <Content />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <dl class="rounded-xl border border-border bg-surface p-5 text-sm">
          {
            facts.map(([label, value]) => (
              <div class="border-b border-border py-3 first:pt-0 last:border-0 last:pb-0">
                <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{label}</dt>
                <dd class="mt-1">{value}</dd>
              </div>
            ))
          }
        </dl>

        {
          data.links.length > 0 && (
            <div class="mt-4 flex flex-col gap-2">
              {data.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener"
                  class="rounded-lg border border-border px-4 py-2.5 text-center text-sm font-medium transition hover:border-accent hover:text-accent"
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </aside>
    </div>

    {
      data.gallery.length > 0 && (
        <section class="mt-14">
          <h2 class="text-xl font-semibold">Gallery</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {data.gallery.map((item) => (
              <figure class="overflow-hidden rounded-xl border border-border">
                <Image src={item.src} alt={item.alt} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 480px" class="w-full" loading="lazy" />
                {item.alt && <figcaption class="px-4 py-2 text-xs text-muted">{item.alt}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
