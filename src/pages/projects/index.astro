---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, collectFilters } from '../../lib/content';

const projects = await getProjects();
const filters = collectFilters(projects);
---

<Base title="Projects" description="Machine learning, computer vision, agentic AI and full-stack projects.">
  <header class="py-10" data-reveal>
    <p class="font-mono text-xs tracking-[0.2em] text-accent-2">// PORTFOLIO</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl">
      <span class="gradient-text">Projects</span>
    </h1>
    <p class="mt-4 max-w-2xl text-muted">
      <span class="font-mono text-accent">{projects.length}</span> projects, newest first. Filter by
      topic.
    </p>
  </header>

  <div id="filters" class="flex flex-wrap gap-2 border-y border-border py-4" data-reveal>
    <button
      type="button"
      data-filter="all"
      aria-pressed="true"
      class="rounded-full border border-border px-3 py-1.5 font-mono text-xs text-muted transition hover:border-accent/60 hover:text-ink aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent"
      >All</button
    >
    {
      filters.map((filter) => (
        <button
          type="button"
          data-filter={filter.toLowerCase()}
          aria-pressed="false"
          class="rounded-full border border-border px-3 py-1.5 font-mono text-xs text-muted transition hover:border-accent/60 hover:text-ink aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent"
        >
          {filter}
        </button>
      ))
    }
  </div>

  <div id="grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, i) => (
        <div data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>

  <p id="empty" hidden class="mt-8 text-muted">No projects match that filter.</p>
</Base>

<script>
  const filters = document.getElementById('filters');
  const grid = document.getElementById('grid');
  const empty = document.getElementById('empty');

  filters?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (!button || !grid || !empty) return;

    const active = button.dataset.filter ?? 'all';
    filters.querySelectorAll('button[data-filter]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b === button)),
    );

    let visible = 0;
    grid.querySelectorAll<HTMLElement>('article[data-tags]').forEach((card) => {
      const tags = (card.dataset.tags ?? '').split('|');
      const show = active === 'all' || tags.includes(active);
      const wrapper = (card.parentElement as HTMLElement | null) ?? card;
      wrapper.hidden = !show;
      if (show) visible += 1;
    });
    empty.hidden = visible > 0;
  });
</script>
