---
import Base from '../layouts/Base.astro';
import Pill from '../components/Pill.astro';
import { site, href } from '../data/site';
import { education, awards, skillGroups, spokenLanguages } from '../data/resume';
import { getExperience } from '../lib/content';
import { dateRange } from '../lib/format';

const roles = await getExperience();

const contacts = [
  { label: 'Email', value: site.email, url: `mailto:${site.email}` },
  { label: 'GitHub', value: '36a5', url: site.github },
  { label: 'LinkedIn', value: 'Abdulrhman Salamah', url: site.linkedin },
  { label: 'Location', value: site.location, url: null },
];
---

<Base title="About" description={site.description}>
  <header class="py-8">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">About</h1>
    <p class="mt-3 text-muted">{site.role} · {site.location}</p>
  </header>

  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px]">
    <div>
      <section class="space-y-5 leading-relaxed">
        <p>
          I am {site.name} ({site.nameArabic}). I build AI systems that make it past the demo stage
          and into daily use. My focus is practical AI for messy real-world data, especially Arabic,
          where most ready-made tools quietly break.
        </p>
        <p>
          That has meant predictive maintenance models for Digital Substations at Saudi Aramco, and
          the Node.js and SQL Server platform that put those predictions in front of engineers;
          computer-vision models that classify and translate Arabic Sign Language; offline voice
          assistants with wake-word detection and Arabic speech pipelines that run with no internet
          connection; and retrieval and fine-tuning pipelines for domain-specific assistants.
          Alongside my degree I spent two and a half years delivering agentic systems and retrieval
          pipelines to paying clients as a freelance engineer.
        </p>
        <p>
          I am most useful to teams who have a prototype that works in a notebook but not in
          production, or who have Arabic data their current stack cannot handle.
        </p>
      </section>

      <section class="mt-12">
        <figure class="rounded-xl border border-border bg-surface p-6">
          <blockquote class="text-lg leading-relaxed">
            <p>“{site.recommendation.quote}”</p>
          </blockquote>
          <figcaption class="mt-4 text-sm text-muted">
            <span class="font-medium text-ink">{site.recommendation.author}</span>
            <br />
            {site.recommendation.authorRole} · {site.recommendation.date}
          </figcaption>
          <a
            href={href(`/letters/${site.recommendation.file}`)}
            class="mt-5 inline-block rounded-lg border border-border px-4 py-2 text-sm font-medium transition hover:border-accent hover:text-accent"
            >Read the full letter (PDF)</a
          >
        </figure>
      </section>

      <section class="mt-14">
        <h2 class="text-2xl font-bold tracking-tight">Experience</h2>
        <ol class="mt-6 space-y-8 border-l border-border pl-6">
          {
            roles.map((role) => (
              <li class="relative">
                <span class="absolute -left-[1.9rem] top-1.5 h-2.5 w-2.5 rounded-full bg-accent" />
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-semibold">{role.data.role}</h3>
                  <span class="text-sm text-muted">
                    {dateRange(role.data.startDate, role.data.endDate, role.data.current ? 'in-progress' : undefined)}
                  </span>
                </div>
                <p class="mt-0.5 text-sm text-accent">{role.data.organisation}</p>
                {role.data.location && <p class="text-sm text-muted">{role.data.location}</p>}
                {role.data.highlights.length > 0 && (
                  <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-muted">
                    {role.data.highlights.map((highlight) => (
                      <li class="before:mr-2 before:text-accent before:content-['—']">{highlight}</li>
                    ))}
                  </ul>
                )}
                {role.data.skills.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {role.data.skills.map((skill) => (
                      <Pill>{skill}</Pill>
                    ))}
                  </div>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-14">
        <h2 class="text-2xl font-bold tracking-tight">Education</h2>
        {
          education.map((entry) => (
            <div class="mt-6 rounded-xl border border-border bg-surface p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-semibold">{entry.degree}</h3>
                <span class="text-sm text-muted">{entry.period}</span>
              </div>
              <p class="mt-0.5 text-sm text-accent">{entry.institution}</p>
              <ul class="mt-3 space-y-1.5 text-sm text-muted">
                {entry.details.map((detail) => (
                  <li class="before:mr-2 before:text-accent before:content-['—']">{detail}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="mt-14">
        <h2 class="text-2xl font-bold tracking-tight">Awards</h2>
        <ul class="mt-6 space-y-4">
          {
            awards.map((award) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border pb-4 last:border-0">
                <div>
                  <p class="font-medium">{award.title}</p>
                  <p class="text-sm text-muted">{award.issuer}</p>
                </div>
                <span class="text-sm text-muted">{award.year}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-14">
        <h2 class="text-2xl font-bold tracking-tight">Skills</h2>
        <div class="mt-6 space-y-6">
          {
            skillGroups.map((group) => (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
                  {group.label}
                </h3>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <Pill>{item}</Pill>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <dl class="rounded-xl border border-border bg-surface p-5 text-sm">
        {
          contacts.map((contact) => (
            <div class="border-b border-border py-3 first:pt-0 last:border-0 last:pb-0">
              <dt class="text-xs font-semibold uppercase tracking-wider text-muted">
                {contact.label}
              </dt>
              <dd class="mt-1 break-words">
                {contact.url ? (
                  <a href={contact.url} class="text-accent hover:underline" rel="noopener">
                    {contact.value}
                  </a>
                ) : (
                  contact.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <dl class="mt-4 rounded-xl border border-border bg-surface p-5 text-sm">
        <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Languages</dt>
        {
          spokenLanguages.map((language) => (
            <dd class="mt-2 flex justify-between gap-3">
              <span>{language.name}</span>
              <span class="text-muted">{language.level}</span>
            </dd>
          ))
        }
      </dl>

      <a
        href={href('/certificates')}
        class="mt-4 block rounded-lg border border-border px-4 py-2.5 text-center text-sm font-medium transition hover:border-accent hover:text-accent"
        >Certificates</a
      >

      {
        site.cvFile && (
          <a
            href={href(`/cv/${site.cvFile}`)}
            class="mt-3 block rounded-lg border border-border px-4 py-2.5 text-center text-sm font-medium transition hover:border-accent hover:text-accent"
          >
            Download CV
          </a>
        )
      }
    </aside>
  </div>
</Base>
