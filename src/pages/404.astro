---
import Base from '../layouts/Base.astro';
import { href } from '../data/site';
---

<Base title="Page not found">
  <section class="py-24 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">This page does not exist</h1>
    <p class="mt-3 text-muted">The link may be out of date, or the page has moved.</p>
    <a
      href={href('/')}
      class="mt-8 inline-block rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90"
      >Back to home</a
    >
  </section>
</Base>
