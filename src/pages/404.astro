---
import Base from '../layouts/Base.astro';
import { href } from '../data/site';
---

<Base title="Page not found">
  <section class="py-24 text-center">
    <p class="gradient-text font-mono text-6xl font-black">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">This page does not exist</h1>
    <p class="mt-3 text-muted">The link may be out of date, or the page has moved.</p>
    <a
      href={href('/')}
      class="mt-8 inline-block rounded-lg bg-gradient-to-r from-accent to-accent-2 px-5 py-2.5 text-sm font-semibold text-white transition hover:shadow-lg hover:shadow-accent/30"
      >Back to home</a
    >
  </section>
</Base>
