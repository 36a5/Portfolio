---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CredentialCard from '../components/CredentialCard.astro';
import NeuralNet from '../components/NeuralNet.astro';
import CodeTerminal from '../components/CodeTerminal.astro';
import StatTiles from '../components/StatTiles.astro';
import TechMarquee from '../components/TechMarquee.astro';
import PipelineStrip from '../components/PipelineStrip.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { site, href } from '../data/site';
import { getFeaturedProjects, getCredentials, getNowEntries } from '../lib/content';

const featured = await getFeaturedProjects(3);
const credentials = (await getCredentials()).slice(0, 3);
const now = (await getNowEntries())[0];

const nowColumns = [
  ['Studying', now?.data.studying ?? []],
  ['Building', now?.data.building ?? []],
  ['Learning', now?.data.learning ?? []],
] as const;
---

<Base>
  <!-- ------------------------------------------------------------- hero -->
  <section class="relative -mx-5 overflow-hidden px-5 py-8 sm:-mx-8 sm:px-8 sm:py-12">
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-40 sm:opacity-70 [mask-image:radial-gradient(ellipse_70%_60%_at_70%_40%,#000,transparent)]">
      <NeuralNet />
    </div>

    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,400px)] lg:gap-10">
      <div>
        {
          now?.data.openToWork && (
            <p data-reveal>
              <span class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent-soft px-3 py-1.5 font-mono text-xs text-accent">
                <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75" />
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-accent" />
                </span>
                open to opportunities
              </span>
            </p>
          )
        }

        <h1
          class="mt-5 text-4xl font-black leading-[1.05] tracking-tight sm:text-6xl"
          data-reveal
          style="--reveal-delay:60ms"
        >
          <span class="gradient-text">{site.name}</span>
        </h1>

        <p
          class="caret mt-3 font-mono text-base text-accent-2 sm:text-lg"
          data-reveal
          style="--reveal-delay:120ms"
        >
          {site.role}
        </p>

        <p
          class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg"
          data-reveal
          style="--reveal-delay:180ms"
        >
          {site.tagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-delay:240ms">
          <a
            href={href('/projects')}
            class="group relative overflow-hidden rounded-lg bg-gradient-to-r from-accent to-accent-2 px-5 py-2.5 text-sm font-semibold text-white transition hover:shadow-lg hover:shadow-accent/30"
          >
            <span class="relative">View projects</span>
          </a>
          {
            site.cvFile && (
              <a
                href={href(`/cv/${site.cvFile}`)}
                class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent"
              >
                Download CV
              </a>
            )
          }
          <a
            href={`mailto:${site.email}`}
            class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium transition hover:border-accent-2 hover:text-accent-2"
            >Get in touch</a
          >
        </div>
      </div>

      <div class="float-slow"><CodeTerminal /></div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ stats -->
  <section class="mt-4"><StatTiles /></section>

  <div class="mt-10 -mx-5 sm:-mx-8"><TechMarquee /></div>

  <section class="mt-10"><PipelineStrip /></section>

  <!-- -------------------------------------------------------------- now -->
  {
    now && (
      <section
        class="group relative mt-14 overflow-hidden rounded-xl border border-border bg-surface p-6"
        data-reveal
        data-glow
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          style="background: radial-gradient(360px circle at var(--glow-x,50%) var(--glow-y,50%), color-mix(in oklab, var(--color-accent) 12%, transparent), transparent 70%)"
        />
        <div class="relative">
          <div class="flex items-baseline justify-between gap-4">
            <p class="font-mono text-xs tracking-[0.2em] text-accent-2">// RIGHT NOW</p>
            <a href={href('/now')} class="font-mono text-sm text-accent hover:underline">
              full status →
            </a>
          </div>
          <p class="mt-3 text-lg leading-relaxed">{now.data.headline}</p>
          <dl class="mt-6 grid gap-5 sm:grid-cols-3">
            {nowColumns.map(([label, items], i) =>
              items.length > 0 ? (
                <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
                  <dt class="font-mono text-xs uppercase tracking-wider text-accent">{label}</dt>
                  <dd class="mt-2 space-y-1.5 text-sm text-muted">
                    {items.map((item) => (
                      <p class="border-l border-border pl-3">{item}</p>
                    ))}
                  </dd>
                </div>
              ) : null,
            )}
          </dl>
        </div>
      </section>
    )
  }

  <!-- --------------------------------------------------------- projects -->
  <section class="mt-16">
    <SectionTitle index="01 // SELECTED WORK" title="Projects" href={href('/projects')} linkLabel="all projects " />
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((project, i) => (
          <div data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- ------------------------------------------------------ credentials -->
  {
    credentials.length > 0 && (
      <section class="mt-16">
        <SectionTitle
          index="02 // CREDENTIALS"
          title="Recent certificates"
          href={href('/certificates')}
          linkLabel="all certificates "
        />
        <div class="mt-6 grid gap-4">
          {credentials.map((credential, i) => (
            <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <CredentialCard credential={credential} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ---------------------------------------------------------- contact -->
  <section
    class="relative mt-16 overflow-hidden rounded-xl border border-border bg-surface p-8 text-center"
    data-reveal
  >
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-25">
      <NeuralNet />
    </div>
    <p class="font-mono text-xs tracking-[0.2em] text-accent-2">03 // CONTACT</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
      Got a model stuck in a notebook?
    </h2>
    <p class="mx-auto mt-3 max-w-lg text-muted">
      I am most useful to teams with a prototype that works locally but not in production, or with
      Arabic data their current stack cannot handle.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="mt-6 inline-block rounded-lg bg-gradient-to-r from-accent to-accent-2 px-6 py-3 text-sm font-semibold text-white transition hover:shadow-lg hover:shadow-accent/30"
      >{site.email}</a
    >
  </section>
</Base>
