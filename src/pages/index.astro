---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CredentialCard from '../components/CredentialCard.astro';
import Pill from '../components/Pill.astro';
import { site, href } from '../data/site';
import { getFeaturedProjects, getCredentials, getNowEntries } from '../lib/content';

const featured = await getFeaturedProjects(3);
const credentials = (await getCredentials()).slice(0, 3);
const now = (await getNowEntries())[0];
---

<Base>
  <section class="py-8 sm:py-14">
    {
      now?.data.openToWork && (
        <p class="mb-5">
          <Pill tone="accent">● Open to opportunities</Pill>
        </p>
      )
    }
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      {site.name}
      <span class="mt-2 block text-lg font-normal text-muted sm:text-xl">{site.role}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{site.tagline}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={href('/projects')}
        class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90"
        >View projects</a
      >
      {
        site.cvFile && (
          <a
            href={href(`/cv/${site.cvFile}`)}
            class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent"
          >
            Download CV
          </a>
        )
      }
      <a
        href={`mailto:${site.email}`}
        class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent"
        >Get in touch</a
      >
    </div>
  </section>

  {
    now && (
      <section class="rounded-xl border border-border bg-surface p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Right now</h2>
          <a href={href('/now')} class="text-sm text-accent hover:underline">
            Full status →
          </a>
        </div>
        <p class="mt-3 text-lg">{now.data.headline}</p>
        <dl class="mt-5 grid gap-4 sm:grid-cols-3">
          {[
            ['Studying', now.data.studying],
            ['Building', now.data.building],
            ['Learning', now.data.learning],
          ].map(([label, items]) =>
            (items as string[]).length > 0 ? (
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{label}</dt>
                <dd class="mt-1.5 space-y-1 text-sm">
                  {(items as string[]).map((i) => (
                    <p>{i}</p>
                  ))}
                </dd>
              </div>
            ) : null,
          )}
        </dl>
      </section>
    )
  }

  <section class="mt-14">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold tracking-tight">Selected projects</h2>
      <a href={href('/projects')} class="text-sm text-accent hover:underline">All projects →</a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {
    credentials.length > 0 && (
      <section class="mt-14">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold tracking-tight">Recent certificates</h2>
          <a href={href('/certificates')} class="text-sm text-accent hover:underline">
            All certificates →
          </a>
        </div>
        <div class="mt-6 grid gap-4">
          {credentials.map((credential) => (
            <CredentialCard credential={credential} />
          ))}
        </div>
      </section>
    )
  }
</Base>
